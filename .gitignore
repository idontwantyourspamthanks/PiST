# Build output. Anchored to the repository root: an unanchored `build/` also
# matches sources such as `src/build/`, which silently excludes them from the
# repository and means a fresh clone cannot be built.
/build/
/build-*/
/cmake-build-*/
/out/
/install/

# CMake
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
Makefile
*.cmake.in
CPackConfig.cmake
CPackSourceConfig.cmake
compile_commands.json

# Qt Creator / Qt tooling
*.user
*.user.*
CMakeLists.txt.user*
*.autosave
.qtc_clangd/
.qmake.stash
qmake.conf

# Compiled / generated
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.a
*.lib
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_autogen/
.objdir/

# Atari ST build artifacts (assembly projects opened in the IDE)
*.prg
*.tos
*.ttp
*.app
*.acc
*.lst
*.sym

# Per-session emulator state
*.sock
hatari.cfg
hatari.nvram
hatari.sav

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Scratch
/tmp/
scratch/
*.log

# Python bytecode (packaging/collect-notices.py runs in CI)
__pycache__/
*.pyc
